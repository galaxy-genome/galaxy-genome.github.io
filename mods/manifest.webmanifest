{
  "name": "Galaxy Genome Mod Maker",
  "short_name": "Mod Maker",
  "description": "Make quests and star systems for Galaxy Genome.",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "theme_color": "#04060e",
  "background_color": "#04060e",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "file", "accept": [".zip", ".json", "application/zip", "application/json"] }]
    }
  }
}
